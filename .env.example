# ==============================================================================
# THE BROAST FACTORY - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.
# NEVER log secret keys anywhere.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broast_factory?schema=public

# Optional direct connection URL if using connection poolers (e.g. Supabase, PgBouncer)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/broast_factory?schema=public

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (min 32 characters) for signing session cookies
ADMIN_SESSION_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Default seeded admin credentials (used ONLY during initial db seed, change immediately after)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=BroastFactoryAdmin@2026

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Public key for client-side Razorpay Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Server-side keys (NEVER expose to client side or commit)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# EMAIL (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# SMTP credentials for sending customer receipts and owner alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@thebroastfactory.com
SMTP_PASSWORD=placeholder_smtp_app_password
EMAIL_FROM="The Broast Factory <orders@thebroastfactory.com>"

# Restaurant owner notification email for incoming orders
OWNER_NOTIFICATION_EMAIL=orders@thebroastfactory.com
